---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" class="relative py-24 md:py-36">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <p class="eyebrow" data-reveal>
          <span class="h-px w-8 bg-flux-500"></span>
          {t.services.eyebrow}
        </p>
        <h2 class="mt-6 text-h2 font-semibold" data-reveal style="--reveal-delay:80ms">
          {t.services.title}
        </h2>
      </div>
      <div class="lg:col-span-5 lg:col-start-8 lg:self-end">
        <p class="text-lead text-mist" data-reveal style="--reveal-delay:160ms">
          {t.services.lead}
        </p>
      </div>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {
        t.services.items.map((service, i) => (
          <article
            class="spotlight panel group flex flex-col p-8 lg:p-10"
            data-reveal
            style={`--reveal-delay:${(i % 2) * 90}ms`}
          >
            <div class="flex items-start justify-between gap-6">
              <span class="font-mono text-xs tracking-widest text-flux-400">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span
                class="text-mute transition-all duration-500 group-hover:translate-x-1 group-hover:text-flux-300"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <h3 class="mt-8 max-w-[22ch] text-h3 font-medium text-fog">{service.title}</h3>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-mist">{service.body}</p>

            <ul class="mt-7 flex flex-wrap gap-2">
              {service.tags.map((tag) => (
                <li class="rounded-full border border-line px-3 py-1 font-mono text-[0.625rem] tracking-wider text-mute uppercase transition-colors duration-500 group-hover:border-flux-500/40 group-hover:text-mist">
                  {tag}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
