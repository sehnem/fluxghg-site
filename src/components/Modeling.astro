---
import { Image } from 'astro:assets';
import footprintImg from '../assets/img/footprint.png';
import ModelDiagram from './ModelDiagram.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="modeling" class="relative py-24 md:py-36">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>
          <span class="h-px w-8 bg-leaf-500"></span>
          {t.modeling.eyebrow}
        </p>
        <h2 class="mt-6 text-h2 font-semibold" data-reveal style="--reveal-delay:80ms">
          {t.modeling.title}
        </h2>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="text-lead text-mist" data-reveal style="--reveal-delay:160ms">
          {t.modeling.lead}
        </p>
      </div>
    </div>

    <!-- Pipeline diagram + modelled output -->
    <div class="mt-16 grid gap-4 lg:grid-cols-12">
      <figure class="panel flex items-center overflow-hidden p-3 sm:p-8 lg:col-span-8" data-reveal>
        <ModelDiagram lang={lang} />
      </figure>

      <figure
        class="relative overflow-hidden rounded-[1.25rem] border border-line lg:col-span-4"
        data-reveal
        style="--reveal-delay:120ms"
      >
        <Image
          src={footprintImg}
          alt={t.modeling.caption}
          widths={[420, 760]}
          sizes="(min-width: 1024px) 32vw, 100vw"
          loading="lazy"
          class="h-64 w-full object-cover [filter:saturate(0.9)_brightness(0.95)] transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] hover:scale-105 lg:h-full"
        />
        <div class="pointer-events-none absolute inset-0 bg-flux-900/15 mix-blend-multiply"></div>
        <figcaption
          class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-void via-void/80 to-transparent p-5 pt-12 text-xs text-mist"
        >
          {t.modeling.caption}
        </figcaption>
      </figure>
    </div>

    <!-- Steps -->
    <ol class="mt-4 grid gap-4 md:grid-cols-3">
      {
        t.modeling.steps.map((step, i) => (
          <li
            class="spotlight panel group p-7 lg:p-8"
            data-reveal
            style={`--reveal-delay:${i * 100}ms`}
          >
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs tracking-widest text-leaf-400">{step.num}</span>
              <span class="h-px flex-1 bg-line transition-colors duration-500 group-hover:bg-leaf-500/50" />
            </div>
            <h3 class="mt-5 text-h3 font-medium">{step.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="mt-8 max-w-[70ch] text-sm text-mute" data-reveal>{t.modeling.note}</p>
  </div>
</section>
