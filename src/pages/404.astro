---
import Base from '../layouts/Base.astro';
import { useTranslations, localePath } from '../i18n/ui';

const t = useTranslations('en');
---

<Base lang="en" title={`${t.notFound.title} — fluxGHG`} description={t.notFound.body}>
  <section class="relative flex min-h-[80svh] items-center overflow-hidden">
    <div class="grid-lines pointer-events-none absolute inset-0 opacity-40 [mask-image:radial-gradient(70%_60%_at_50%_50%,#000,transparent)]"></div>
    <div class="container-page relative pt-32 pb-20">
      <p class="eyebrow"><span class="h-px w-8 bg-flux-500"></span>Error 404</p>
      <h1 class="mt-6 text-h2 font-semibold">{t.notFound.title}</h1>
      <p class="mt-6 max-w-[46ch] text-lead text-mist">{t.notFound.body}</p>
      <a
        href={localePath('en')}
        class="group mt-10 inline-flex items-center gap-3 rounded-full bg-fog px-7 py-4 text-sm font-semibold text-ink transition-transform duration-300 hover:scale-[1.03]"
      >
        {t.notFound.cta}
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </section>
</Base>
