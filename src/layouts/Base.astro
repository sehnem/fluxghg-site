---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, localePath, useTranslations, site, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Set true to keep a page out of search results (e.g. a future staging copy). */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(localePath(lang), Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'fluxGHG',
  url: Astro.site?.href,
  logo: new URL('/assets/logo/horizontal_darkblue.svg', Astro.site).href,
  email: site.email,
  description: pageDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  areaServed: 'BR',
  knowsAbout: [
    'Eddy covariance',
    'Greenhouse gas monitoring',
    'Evapotranspiration',
    'Carbon balance',
    'Precision agriculture',
  ],
};
---

<!doctype html>
<html lang={htmlLang[lang]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(localePath('en'), Astro.site).href} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(localePath('pt'), Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en'), Astro.site).href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#04070a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:site_name" content="fluxGHG" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/assets/fonts/worksans-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      // Mark JS availability before first paint so reveal animations only
      // hide content when they can also un-hide it.
      document.documentElement.classList.add('js');
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>

  <body class="bg-void text-fog antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-flux-500 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-ink"
    >
      {t.nav.skip}
    </a>

    <div
      id="scroll-progress"
      class="fixed inset-x-0 top-0 z-[90] h-px origin-left scale-x-0 bg-gradient-to-r from-flux-500 via-flux-300 to-leaf-400"
      aria-hidden="true"
    >
    </div>

    <Header lang={lang} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
