---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="measure" class="relative py-24 md:py-36">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>
          <span class="h-px w-8 bg-flux-500"></span>
          {t.measure.eyebrow}
        </p>
        <h2 class="mt-6 text-h2 font-semibold" data-reveal style="--reveal-delay:80ms">
          {t.measure.title}
        </h2>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:self-end">
        <p class="text-lead text-mist" data-reveal style="--reveal-delay:160ms">
          {t.measure.lead}
        </p>
      </div>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-[1.5rem] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        t.measure.items.map((item, i) => (
          <article
            class="spotlight group relative flex flex-col bg-shell p-7 transition-colors duration-500 hover:bg-panel lg:p-8"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <div class="flex items-start justify-between gap-4">
              <span class="font-mono text-2xl font-medium text-flux-400 transition-transform duration-500 group-hover:-translate-y-0.5 lg:text-[1.75rem]">
                {item.symbol}
              </span>
              <span class="mt-1 font-mono text-[0.625rem] tracking-wider text-mute">
                {item.unit}
              </span>
            </div>
            <h3 class="mt-8 text-h3 font-medium">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist">{item.body}</p>
            <span
              class="mt-8 block h-px w-full origin-left scale-x-0 bg-gradient-to-r from-flux-500 to-transparent transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-x-100"
              aria-hidden="true"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
