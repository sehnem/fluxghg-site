---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="relative border-t border-line py-24 md:py-36">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>
          <span class="h-px w-8 bg-flux-500"></span>
          {t.about.eyebrow}
        </p>
        <h2 class="mt-6 max-w-[18ch] text-h2 font-semibold" data-reveal style="--reveal-delay:80ms">
          {t.about.title}
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
        <p class="text-lead text-mist" data-reveal style="--reveal-delay:160ms">{t.about.lead}</p>
      </div>
    </div>

    <dl class="mt-16 grid gap-x-4 gap-y-12 md:grid-cols-3">
      {
        t.about.items.map((item, i) => (
          <div class="group" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-xs text-flux-400">{String(i + 1).padStart(2, '0')}</span>
              <span class="h-px flex-1 bg-line" />
            </div>
            <dt class="mt-6 text-h3 font-medium">{item.title}</dt>
            <dd class="mt-4 max-w-[46ch] text-sm leading-relaxed text-mist">{item.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
